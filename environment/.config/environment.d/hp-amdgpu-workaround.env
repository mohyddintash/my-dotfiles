# HP Pavilion x360: never call dpms off — AMD GPU hangs permanently on resume.
# OMARCHY_LOCK_ONLY=true tells omarchy-system-lock to skip omarchy-brightness-display off.
# This must be set for the entire user session so hypridle inherits it even after omarchy
# update overwrites hypridle.conf and removes the explicit env var prefix.
OMARCHY_LOCK_ONLY=true
