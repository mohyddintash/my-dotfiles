#!/bin/bash

# Exit if no project directory is provided
if [ -z "$1" ]; then
  echo "Please provide a project directory."
  exit 1
fi

# The full path to the project directory
PROJECT_PATH=$(realpath "$1")
# The name of the project folder, used for the session name.
# tmux forbids '.' and ':' in session names, so swap both for '_'.
SESSION_NAME=$(basename "$PROJECT_PATH" | tr '.:' '__')

# Detect a dev-server command from a directory's lockfile/manifest.
# mise (activated in .bashrc) already switches tool versions per-directory,
# so this only needs to pick *which* command to run, not which version.
detect_pm_dev_command() {
  local dir="$1"
  if [ -f "$dir/bun.lockb" ] || [ -f "$dir/bun.lock" ]; then
    echo "bun run dev"
  elif [ -f "$dir/pnpm-lock.yaml" ]; then
    echo "pnpm run dev"
  elif [ -f "$dir/yarn.lock" ]; then
    echo "yarn dev"
  elif [ -f "$dir/package-lock.json" ]; then
    echo "npm run dev"
  elif [ -f "$dir/package.json" ] && grep -q '"dev"' "$dir/package.json"; then
    echo "npm run dev"
  fi
}

detect_dev_command() {
  if [ -f "$PROJECT_PATH/Cargo.toml" ]; then
    echo "cargo run"
    return
  fi
  detect_pm_dev_command "$PROJECT_PATH"
}

# Docker compose file at the project root, if any.
detect_compose_file() {
  local f
  for f in compose.yml compose.yaml docker-compose.yml docker-compose.yaml; do
    if [ -f "$PROJECT_PATH/$f" ]; then
      echo "$f"
      return
    fi
  done
}

# pnpm-workspace.yaml member directories (besides '.') that have their own
# "dev" script. Only handles a plain list under `packages:` — doesn't expand
# globs like 'apps/*', which is fine for the monorepos this targets so far.
workspace_dev_members() {
  local workspace_file="$PROJECT_PATH/pnpm-workspace.yaml"
  [ -f "$workspace_file" ] || return
  awk '
    /^packages:/ { in_packages=1; next }
    in_packages && /^[^[:space:]-]/ { in_packages=0 }
    in_packages && /^[[:space:]]*-/ {
      line=$0
      sub(/^[[:space:]]*-[[:space:]]*/, "", line)
      gsub(/["'"'"']/, "", line)
      print line
    }
  ' "$workspace_file" | while read -r member; do
    [ "$member" = "." ] && continue
    [ -f "$PROJECT_PATH/$member/package.json" ] || continue
    grep -q '"dev"' "$PROJECT_PATH/$member/package.json" && echo "$member"
  done
}

new_window() {
  local name="$1" cmd="$2" dir="${3:-$PROJECT_PATH}"
  tmux new-window -t "$SESSION_NAME" -n "$name" -c "$dir"
  tmux send-keys -t "$SESSION_NAME:$name" "$cmd" C-m
}

if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  # Session exists, so attach to it
  echo "Attaching to existing session: $SESSION_NAME"
  tmux attach-session -t "$SESSION_NAME"
else
  # Session does not exist, so create it
  echo "Creating new session: $SESSION_NAME"

  # Start a new, detached tmux session
  # -d: detached
  # -s: session name
  # -c: starting directory
  tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_PATH"

  # --- Window 1: Code ---
  # Rename the first window. Target the session (not an index) since
  # base-index may not be 0 depending on tmux.conf.
  tmux rename-window -t "$SESSION_NAME" "Code"
  # Open the editor in the first pane
  tmux send-keys -t "$SESSION_NAME:Code" "nvim" C-m

  # Split the window vertically
  tmux split-window -v -t "$SESSION_NAME:Code" -c "$PROJECT_PATH"
  # Send a command to the new pane (e.g., a git client)
  tmux send-keys -t "$SESSION_NAME:Code.1" "lazygit" C-m

  # --- Window 2: Dev (root dev-server command, if recognized) ---
  DEV_COMMAND=$(detect_dev_command)
  if [ -n "$DEV_COMMAND" ]; then
    new_window "Dev" "$DEV_COMMAND"
  fi

  # --- Window 3: DB (docker compose, if a compose file exists) ---
  COMPOSE_FILE=$(detect_compose_file)
  if [ -n "$COMPOSE_FILE" ]; then
    new_window "DB" "docker compose up"
  fi

  # --- Window 4+: one per pnpm workspace member with its own dev script ---
  while read -r member; do
    [ -n "$member" ] || continue
    MEMBER_CMD=$(detect_pm_dev_command "$PROJECT_PATH/$member")
    [ -n "$MEMBER_CMD" ] || continue
    MEMBER_NAME=$(basename "$member")
    new_window "${MEMBER_NAME^}" "$MEMBER_CMD" "$PROJECT_PATH/$member"
  done < <(workspace_dev_members)

  # Attach to the newly created session
  tmux attach-session -t "$SESSION_NAME"
fi
